<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Radpa.UI.ViewModels"
             x:Class="Radpa.UI.Views.PrivacyAuditorView"
             x:DataType="vm:PrivacyAuditorViewModel"
             x:CompileBindings="True">
  <StackPanel Spacing="14" Margin="16">
    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding Loc.PrivacyTitle}" FontSize="18" FontWeight="Bold" />
        <TextBlock Text="{Binding Loc.PrivacySubtitle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
        <WrapPanel Orientation="Horizontal" ItemSpacing="12">
          <TextBox Width="260" Watermark="{Binding Loc.SearchWatermark}" Text="{Binding FilterText}" />
          <CheckBox Content="{Binding Loc.PrivacyFirstTimeOnly}" IsChecked="{Binding FirstTimeOnly}" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
      <DataGrid x:Name="AuditDataGrid"
                ItemsSource="{Binding Entries}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserSortColumns="True"
                MinHeight="400"
                FlowDirection="{Binding Loc.FlowDirection}">
        <DataGrid.Columns>
          <DataGridTextColumn x:DataType="vm:PrivacyAuditRowViewModel" Binding="{Binding AppName}" Width="160" />
          <DataGridTextColumn x:DataType="vm:PrivacyAuditRowViewModel" Binding="{Binding InterfaceLabel}" Width="140" />
          <DataGridTextColumn x:DataType="vm:PrivacyAuditRowViewModel" Binding="{Binding RemoteIp}" Width="135" />
          <DataGridTextColumn x:DataType="vm:PrivacyAuditRowViewModel" Binding="{Binding DomainDisplay}" Width="190" />
          <DataGridTextColumn x:DataType="vm:PrivacyAuditRowViewModel" Binding="{Binding SentText}" Width="105" />
          <DataGridTextColumn x:DataType="vm:PrivacyAuditRowViewModel" Binding="{Binding ReceivedText}" Width="105" />
          <DataGridTextColumn x:DataType="vm:PrivacyAuditRowViewModel" Binding="{Binding FirstSeenText}" Width="140" />
          <DataGridTextColumn x:DataType="vm:PrivacyAuditRowViewModel" Binding="{Binding NewBadgeText}" Width="75" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </StackPanel>
</UserControl>
