<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Radpa.UI.ViewModels"
             x:Class="Radpa.UI.Views.PrivacyAuditorView"
             x:DataType="vm:PrivacyAuditorViewModel"
             x:CompileBindings="True">
  <ScrollViewer>
    <StackPanel Spacing="14" Margin="16">
      <!-- Guide Banner -->
      <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel Spacing="10">
          <DockPanel>
            <TextBlock Text="🛡️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Loc.PrivacyGuideTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="{Binding Loc.PrivacyGuidePoints}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Search & Filters -->
      <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Loc.PrivacyTitle}" FontSize="18" FontWeight="Bold" />
          <TextBlock Text="{Binding Loc.PrivacySubtitle}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal" ItemSpacing="12">
            <TextBox Width="280" PlaceholderText="{Binding Loc.SearchWatermark}" Text="{Binding FilterText}" />
            <CheckBox Content="{Binding Loc.PrivacyFirstTimeOnly}" IsChecked="{Binding FirstTimeOnly}" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Auditor DataGrid -->
      <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
        <DataGrid x:Name="AuditDataGrid"
                  ItemsSource="{Binding Entries}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  MinHeight="400"
                  FlowDirection="{Binding Loc.FlowDirection}">
          <DataGrid.Columns>
            <DataGridTextColumn x:DataType="vm:PrivacyAuditRowViewModel" Binding="{Binding AppName}" Width="Auto" MinWidth="160" />
            <DataGridTextColumn x:DataType="vm:PrivacyAuditRowViewModel" Binding="{Binding InterfaceLabel}" Width="Auto" MinWidth="130" />
            <DataGridTextColumn x:DataType="vm:PrivacyAuditRowViewModel" Binding="{Binding RemoteIp}" Width="Auto" MinWidth="130" />
            <DataGridTextColumn x:DataType="vm:PrivacyAuditRowViewModel" Binding="{Binding DomainDisplay}" Width="Auto" MinWidth="180" />
            <DataGridTextColumn x:DataType="vm:PrivacyAuditRowViewModel" Binding="{Binding SentText}" Width="Auto" MinWidth="105" />
            <DataGridTextColumn x:DataType="vm:PrivacyAuditRowViewModel" Binding="{Binding ReceivedText}" Width="Auto" MinWidth="105" />
            <DataGridTextColumn x:DataType="vm:PrivacyAuditRowViewModel" Binding="{Binding FirstSeenText}" Width="Auto" MinWidth="140" />
            <DataGridTextColumn x:DataType="vm:PrivacyAuditRowViewModel" Binding="{Binding NewBadgeText}" Width="Auto" MinWidth="80" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
