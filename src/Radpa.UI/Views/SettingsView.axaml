<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Radpa.UI.ViewModels"
             xmlns:dom="using:Radpa.Domain.Entities"
             x:Class="Radpa.UI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="True">
  <ScrollViewer>
    <StackPanel Spacing="14" Margin="16">
      <!-- General & Appearance -->
      <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Loc.SettingsGeneral}" FontSize="16" FontWeight="Bold" />
          <CheckBox Content="{Binding Loc.SettingsLanguage}" IsChecked="{Binding IsPersianLanguage}" />
          <CheckBox Content="{Binding Loc.SettingsTheme}" IsChecked="{Binding IsDarkTheme}" />
          <CheckBox Content="{Binding Loc.SettingsPersianDigits}" IsChecked="{Binding UsePersianDigits}" />
          <CheckBox Content="{Binding Loc.SettingsNotificationsEnabled}" IsChecked="{Binding NotificationsEnabled}" />
          <CheckBox Content="{Binding Loc.SettingsStartWithWindows}" IsChecked="{Binding StartWithWindows}" />
          <CheckBox Content="{Binding Loc.SettingsMinimizeToTray}" IsChecked="{Binding MinimizeToTray}" />
          <CheckBox Content="{Binding Loc.SettingsPortableMode}" IsChecked="{Binding PortableMode}" />
          <CheckBox Content="{Binding Loc.SettingsRecordTitles}" IsChecked="{Binding RecordWindowTitles}" />
          <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="8">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Loc.SettingsIdleThreshold}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
              <NumericUpDown Width="140" Minimum="15" Maximum="3600" Value="{Binding IdleThresholdSeconds}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Loc.SettingsSamplingInterval}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
              <NumericUpDown Width="140" Minimum="2" Maximum="60" Value="{Binding SamplingIntervalSeconds}" />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Loc.SettingsRetentionDays}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
              <NumericUpDown Width="140" Minimum="1" Maximum="3650" Value="{Binding RetentionDays}" />
            </StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Network Admin Mode & Encryption -->
      <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel Spacing="10">
          <!-- Administrator Status Banner -->
          <Border IsVisible="{Binding IsRunningAsAdmin}"
                  Background="#1F38E8C8"
                  BorderBrush="{DynamicResource AccentBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12">
            <DockPanel>
              <TextBlock Text="🛡️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Loc.SettingsAdminActiveTitle}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FontSize="13" />
                <TextBlock Text="{Binding Loc.SettingsAdminActiveDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Border>

          <Border IsVisible="{Binding !IsRunningAsAdmin}"
                  Background="#1FFBBF24"
                  BorderBrush="{DynamicResource WarningBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12">
            <DockPanel>
              <TextBlock Text="ℹ️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Loc.SettingsStandardUserTitle}" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" FontSize="13" />
                <TextBlock Text="{Binding Loc.SettingsStandardUserDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
          </Border>
          <CheckBox Content="{Binding Loc.SettingsDetailedNetwork}" IsChecked="{Binding DetailedNetworkEnabled}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Loc.SettingsNetworkAdminExplanation}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" />
          <CheckBox Content="{Binding Loc.SettingsEncryption}" IsChecked="{Binding EncryptionEnabled}" FontWeight="SemiBold" />
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding MigrationProgress}" IsVisible="{Binding IsBusy}" Height="6" />
        </StackPanel>
      </Border>

      <!-- Radpa Self-Monitor (Software details & footprint) -->
      <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel Spacing="12">
          <DockPanel>
            <Button DockPanel.Dock="Right"
                    Content="{Binding Loc.SettingsBtnRefreshSelf}"
                    Command="{Binding RefreshSelfMetricsCommand}"
                    Padding="12,5"
                    FontSize="12"
                    VerticalAlignment="Center" />
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Loc.SettingsSelfMonitorTitle}" FontSize="16" FontWeight="Bold" />
              <TextBlock Text="{Binding Loc.SettingsSelfMonitorDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>

          <!-- Metric Cards -->
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
            <Border Grid.Column="0" Background="#10FFFFFF" CornerRadius="8" Padding="10">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Loc.SettingsSelfCpu}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="{Binding SelfCpuText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#10FFFFFF" CornerRadius="8" Padding="10">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Loc.SettingsSelfRam}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="{Binding SelfRamText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#10FFFFFF" CornerRadius="8" Padding="10">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Loc.SettingsSelfPrivate}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="{Binding SelfPrivateBytesText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#10FFFFFF" CornerRadius="8" Padding="10">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Loc.SettingsSelfDb}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="{Binding DatabaseSizeText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentSecondaryBrush}" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- Process Details Row -->
          <WrapPanel Orientation="Horizontal" ItemSpacing="20" LineSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Loc.SettingsSelfPid, StringFormat='{}{0}:'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
              <TextBlock Text="{Binding SelfProcessIdText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Loc.SettingsSelfThreads, StringFormat='{}{0}:'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
              <TextBlock Text="{Binding SelfThreadCountText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Loc.SettingsSelfNetworkHelper, StringFormat='{}{0}:'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
              <TextBlock Text="{Binding NetworkHelperStatusText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
            </StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Software Updates (Separated Section) -->
      <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel Spacing="10">
          <DockPanel>
            <Border DockPanel.Dock="Right" Background="#2038E8C8" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
              <TextBlock Text="{Binding AppVersionText, StringFormat='{}v{0}'}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12" />
            </Border>
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Loc.SettingsUpdatesTitle}" FontSize="16" FontWeight="Bold" />
              <TextBlock Text="{Binding Loc.SettingsUpdatesDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>

          <CheckBox Content="{Binding Loc.SettingsAutoUpdateCheck}" IsChecked="{Binding UpdateCheckEnabled}" />

          <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
            <TextBox Width="260" Text="{Binding UpdateRepository}" PlaceholderText="owner/repo" />
            <Button Content="{Binding Loc.SettingsCheckUpdate}" Command="{Binding CheckForUpdatesNowCommand}" FontWeight="SemiBold" />
          </WrapPanel>

          <TextBlock Text="{Binding UpdateStatusText}" IsVisible="{Binding UpdateStatusText.Length}" Foreground="{DynamicResource AccentBrush}" FontSize="12" />
        </StackPanel>
      </Border>

      <!-- Data Controls, Export & Maintenance -->
      <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Loc.SettingsDataControlsTitle}" FontSize="16" FontWeight="Bold" />
          <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
            <Button Content="{Binding Loc.BtnSaveSettings}" Command="{Binding SaveSettingsCommand}" Background="{DynamicResource AccentBrush}" Foreground="#0F172A" FontWeight="Bold" />
            <Button Content="{Binding Loc.BtnExportCsv}" Command="{Binding ExportCsvCommand}" />
            <Button Content="{Binding Loc.BtnExportJson}" Command="{Binding ExportJsonCommand}" />
            <Button Content="{Binding Loc.BtnExportHtml}" Command="{Binding ExportHtmlCommand}" />
            <Button Content="{Binding Loc.BtnVacuumDb}" Command="{Binding ApplyRetentionAndVacuumCommand}" />
            <Button Content="{Binding Loc.BtnDeleteAll}" Command="{Binding DeleteAllDataCommand}" Foreground="{DynamicResource DangerBrush}" />
          </WrapPanel>
          <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage.Length}" Foreground="{DynamicResource AccentBrush}" FontSize="12" />
        </StackPanel>
      </Border>

      <!-- Grouping Rules -->
      <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Loc.SettingsGroupingRules}" FontSize="16" FontWeight="Bold" />
          <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
            <TextBox Width="180" PlaceholderText="exe (e.g. brave.exe)" Text="{Binding NewGroupPattern}" />
            <TextBox Width="180" PlaceholderText="Group Name" Text="{Binding NewGroupTarget}" />
            <Button Content="{Binding Loc.BtnAddRule}" Command="{Binding AddGroupingRuleCommand}" />
          </WrapPanel>
          <ItemsControl ItemsSource="{Binding GroupingRules}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="dom:GroupingRule">
                <Border Background="#10FFFFFF" CornerRadius="6" Padding="10,6" Margin="0,3">
                  <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveGroupingRuleCommand}"
                            CommandParameter="{Binding .}"
                            Background="Transparent"
                            Foreground="{DynamicResource DangerBrush}"
                            Padding="8,2" />
                    <TextBlock Text="{Binding TargetGroupName}" FontWeight="SemiBold" Width="170" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Pattern}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
