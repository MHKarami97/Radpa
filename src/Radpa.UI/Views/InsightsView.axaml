<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Radpa.UI.ViewModels"
             xmlns:dom="using:Radpa.Domain.Entities"
             x:Class="Radpa.UI.Views.InsightsView"
             x:DataType="vm:InsightsViewModel"
             x:CompileBindings="True">
  <ScrollViewer>
    <StackPanel Spacing="14" Margin="16">
      <!-- Guide Banner -->
      <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel Spacing="10">
          <DockPanel>
            <TextBlock Text="💡" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Loc.InsightsGuideTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="{Binding Loc.InsightsGuideAnomalies}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Loc.InsightsGuideHealth}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Loc.InsightsGuideRules}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Loc.InsightsGuidePeriod}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Anomalies -->
      <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Loc.InsightsAnomalies}" FontWeight="Bold" FontSize="15" />
          <Border IsVisible="{Binding !HasAnomalies}" Background="#1538E8C8" BorderBrush="#3038E8C8" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="✅" FontSize="14" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Loc.InsightsAnomaliesEmpty}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Anomalies}" IsVisible="{Binding HasAnomalies}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="dom:AnomalyAlert">
                <Border Background="#26FBBF24" CornerRadius="6" Padding="8" Margin="0,2">
                  <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Health Score Breakdown -->
      <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Loc.InsightsHealthBreakdown}" FontWeight="Bold" FontSize="15" />
          <DataGrid x:Name="HealthGrid"
                    ItemsSource="{Binding HealthRows}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserResizeColumns="True"
                    MinHeight="180"
                    MaxHeight="260"
                    FlowDirection="{Binding Loc.FlowDirection}">
            <DataGrid.Columns>
              <DataGridTextColumn x:DataType="vm:HealthBreakdownRowViewModel" Binding="{Binding AppName}" Width="Auto" MinWidth="180" />
              <DataGridTextColumn x:DataType="vm:HealthBreakdownRowViewModel" Binding="{Binding TotalText}" Width="Auto" MinWidth="90" />
              <DataGridTextColumn x:DataType="vm:HealthBreakdownRowViewModel" Binding="{Binding ResourceText}" Width="Auto" MinWidth="120" />
              <DataGridTextColumn x:DataType="vm:HealthBreakdownRowViewModel" Binding="{Binding NetworkText}" Width="Auto" MinWidth="120" />
              <DataGridTextColumn x:DataType="vm:HealthBreakdownRowViewModel" Binding="{Binding StartupText}" Width="Auto" MinWidth="120" />
              <DataGridTextColumn x:DataType="vm:HealthBreakdownRowViewModel" Binding="{Binding Grade}" Width="Auto" MinWidth="80" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>

      <!-- Rules Engine -->
      <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Loc.InsightsRulesEngine}" FontWeight="Bold" FontSize="15" />
          <TextBlock Text="{Binding Loc.RuleDescriptionHint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
            <TextBox Width="180" PlaceholderText="{Binding Loc.RuleNamePlaceholder}" Text="{Binding NewRuleName}" />
            <TextBox Width="160" PlaceholderText="{Binding Loc.RuleAppPatternPlaceholder}" Text="{Binding NewRuleAppPattern}" />
            <NumericUpDown Width="130" Minimum="1" Maximum="100000" Value="{Binding NewRuleMaxUploadMbPerHour}" />
            <TextBlock Text="{Binding Loc.RuleLimitUnit}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
            <Button Content="{Binding Loc.BtnAddRule}" Command="{Binding AddRuleCommand}" FontWeight="SemiBold" />
          </WrapPanel>
          <ItemsControl ItemsSource="{Binding Rules}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="dom:NetworkAlertRule">
                <Border Background="#10FFFFFF" CornerRadius="6" Padding="10,6" Margin="0,3">
                  <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            Command="{Binding $parent[UserControl].((vm:InsightsViewModel)DataContext).RemoveRuleCommand}"
                            CommandParameter="{Binding .}"
                            Background="Transparent"
                            Foreground="{DynamicResource DangerBrush}"
                            Padding="8,2" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="180" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AppPattern}" Foreground="{DynamicResource TextMutedBrush}" Width="140" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding MaxUploadMegabytesPerHour, StringFormat='{}{0} MB/h'}" Foreground="{DynamicResource AccentSecondaryBrush}" VerticalAlignment="Center" />
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Period Comparison -->
      <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel Spacing="8">
          <DockPanel>
            <TextBlock Text="{Binding Loc.InsightsPeriodCompare}" FontWeight="Bold" FontSize="15" />
            <Button Content="{Binding Loc.BtnRunCompare}" Command="{Binding CompareLastWeekVsPreviousCommand}" HorizontalAlignment="Right" />
          </DockPanel>
          <DataGrid x:Name="CompareGrid"
                    ItemsSource="{Binding ComparisonRows}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserResizeColumns="True"
                    MinHeight="180"
                    MaxHeight="260"
                    FlowDirection="{Binding Loc.FlowDirection}">
            <DataGrid.Columns>
              <DataGridTextColumn x:DataType="vm:ComparisonRowViewModel" Binding="{Binding AppName}" Width="Auto" MinWidth="180" />
              <DataGridTextColumn x:DataType="vm:ComparisonRowViewModel" Binding="{Binding BeforeActiveText}" Width="Auto" MinWidth="120" />
              <DataGridTextColumn x:DataType="vm:ComparisonRowViewModel" Binding="{Binding AfterActiveText}" Width="Auto" MinWidth="120" />
              <DataGridTextColumn x:DataType="vm:ComparisonRowViewModel" Binding="{Binding ActiveDeltaText}" Width="Auto" MinWidth="120" />
              <DataGridTextColumn x:DataType="vm:ComparisonRowViewModel" Binding="{Binding CpuDeltaText}" Width="Auto" MinWidth="90" />
              <DataGridTextColumn x:DataType="vm:ComparisonRowViewModel" Binding="{Binding NetDeltaText}" Width="Auto" MinWidth="120" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
