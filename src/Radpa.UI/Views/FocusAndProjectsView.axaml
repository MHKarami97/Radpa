<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Radpa.UI.ViewModels"
             xmlns:dom="using:Radpa.Domain.Entities"
             x:Class="Radpa.UI.Views.FocusAndProjectsView"
             x:DataType="vm:FocusAndProjectsViewModel"
             x:CompileBindings="True">
  <ScrollViewer>
    <StackPanel Spacing="16" Margin="16">
      <!-- Guide Banner -->
      <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel Spacing="10">
          <DockPanel>
            <TextBlock Text="🎯" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Loc.FocusGuideTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Text="{Binding Loc.FocusGuideSession}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Loc.FocusGuideProjects}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Focus Session Card -->
      <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Loc.FocusTimerTitle}" FontSize="17" FontWeight="Bold" />
          <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="8">
            <TextBlock Text="{Binding Loc.FocusMinutes}" VerticalAlignment="Center" />
            <NumericUpDown Width="110" Minimum="1" Maximum="240" Value="{Binding FocusMinutes}" />
            <TextBox Width="280" PlaceholderText="{Binding Loc.FocusDistractingApps}" Text="{Binding DistractingAppsText}" />
            <Button Content="{Binding Loc.FocusStart}" Command="{Binding StartFocusCommand}" IsEnabled="{Binding !IsFocusRunning}" Background="{DynamicResource AccentBrush}" Foreground="#0F172A" FontWeight="Bold" />
            <Button Content="{Binding Loc.FocusStop}" Command="{Binding StopFocusCommand}" IsEnabled="{Binding IsFocusRunning}" />
          </WrapPanel>
          <TextBlock Text="{Binding LiveFocusStatusText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding LastCompletedReport}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Project Time Tagging Card -->
      <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Loc.ProjectsTitle}" FontSize="17" FontWeight="Bold" />
          <TextBlock Text="{Binding Loc.ProjectRuleHint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
            <TextBox Width="180" PlaceholderText="{Binding Loc.ProjectNamePlaceholder}" Text="{Binding NewProjectName}" />
            <TextBox Width="200" PlaceholderText="{Binding Loc.ProjectPatternPlaceholder}" Text="{Binding NewProjectPattern}" />
            <Button Content="{Binding Loc.BtnAddRule}" Command="{Binding AddProjectRuleCommand}" FontWeight="SemiBold" />
          </WrapPanel>
          <ItemsControl ItemsSource="{Binding ProjectRules}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="dom:ProjectTagRule">
                <Border Background="#10FFFFFF" CornerRadius="6" Padding="10,6" Margin="0,3">
                  <DockPanel>
                    <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" Width="180" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Pattern}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <DataGrid x:Name="ProjectGrid"
                    ItemsSource="{Binding ProjectSummaries}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserResizeColumns="True"
                    MinHeight="180"
                    FlowDirection="{Binding Loc.FlowDirection}">
            <DataGrid.Columns>
              <DataGridTextColumn x:DataType="vm:ProjectSummaryRowViewModel" Binding="{Binding ProjectName}" Width="Auto" MinWidth="200" />
              <DataGridTextColumn x:DataType="vm:ProjectSummaryRowViewModel" Binding="{Binding ActiveText}" Width="Auto" MinWidth="160" />
              <DataGridTextColumn x:DataType="vm:ProjectSummaryRowViewModel" Binding="{Binding OnScreenText}" Width="Auto" MinWidth="160" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
